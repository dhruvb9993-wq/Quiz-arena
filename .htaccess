# QuizArena — Apache/LiteSpeed security rules
Options -Indexes

# Block access to sensitive paths
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app/ - [F,L]
  RewriteRule ^\.htaccess - [F,L]
</IfModule>

# Block common exploit files
<FilesMatch "\.(sql|log|ini|sh|bak|old|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Protect uploads from PHP execution (defense in depth)
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pl|py|cgi|sh)$">
    <If "%{REQUEST_URI} =~ m#/assets/uploads/#">
      Require all denied
    </If>
  </FilesMatch>
</IfModule>

# Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

DirectoryIndex index.php index.html
